{
  "name": "dhwaniflow",
  "version": "1.11.0",
  "description": "Hinglish voice dictation desktop app for developers, powered by Gnani Prisma and Timbre",
  "main": "main.js",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "compile:globe": "node scripts/build-globe-listener.js",
    "compile:fast-paste": "node scripts/build-macos-fast-paste.js",
    "compile:winkeys": "node scripts/build-windows-key-listener.js",
    "compile:linuxkeys": "node scripts/build-linux-key-listener.js",
    "compile:winpaste": "node scripts/build-windows-fast-paste.js",
    "compile:linux-paste": "node scripts/build-linux-fast-paste.js",
    "compile:window-bounds": "node scripts/build-macos-window-bounds.js",
    "compile:native": "npm run compile:globe && npm run compile:fast-paste && npm run compile:winkeys && npm run compile:linuxkeys && npm run compile:winpaste && npm run compile:linux-paste && npm run compile:window-bounds",
    "prestart": "npm run compile:native",
    "start": "electron .",
    "dev": "concurrently -k -r \"npm:dev:renderer\" \"npm:dev:main\"",
    "predev:main": "npm run compile:native",
    "dev:main": "cross-env NODE_ENV=development node scripts/run-electron.js --dev",
    "dev:renderer": "cd src && vite",
    "prebuild": "npm run compile:native",
    "build": "cd src && vite build && cd .. && electron-builder",
    "postinstall": "electron-builder install-app-deps",
    "build:renderer": "cd src && vite build",
    "compile:mac-icon": "node scripts/compile-macos-icon.js",
    "prebuild:mac": "npm run compile:native && npm run compile:mac-icon",
    "build:mac": "npm run build:renderer && electron-builder --mac",
    "build:mac:arm64": "npm run build:renderer && electron-builder --mac --arm64",
    "build:mac:x64": "npm run build:renderer && electron-builder --mac --x64",
    "prebuild:win": "npm run compile:native",
    "build:win": "npm run build:renderer && electron-builder --win",
    "dist:win": "npm run build:renderer && electron-builder --config electron-builder.unsigned-win.json --win",
    "dist:win:release": "npm run prepare:win && npm run build:renderer && electron-builder --config electron-builder-release-win.json --win",
    "prebuild:linux": "npm run compile:native",
    "build:linux": "npm run build:renderer && electron-builder --linux",
    "build:linux:appimage": "npm run build:renderer && electron-builder --linux AppImage",
    "build:linux:deb": "npm run build:renderer && electron-builder --linux deb",
    "build:linux:rpm": "npm run build:renderer && electron-builder --linux rpm",
    "build:linux:tar": "npm run build:renderer && electron-builder --linux tar.gz",
    "prepack": "npm run compile:native",
    "pack": "npm run build:renderer && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --dir",
    "predist": "npm run compile:native",
    "dist": "npm run build:renderer && electron-builder",
    "format:js": "eslint . --fix && cd src && eslint . --fix && prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format": "npm run format:js",
    "format:check": "eslint . && cd src && eslint . && prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "lint": "eslint . && cd src && eslint .",
    "test": "node --import tsx --test \"test/**/*.test.js\"",
    "typecheck": "cd src && tsc --noEmit",
    "quality-check": "npm run format:check && npm run typecheck",
    "i18n:check": "node scripts/check-i18n.js",
    "preview": "cd src && vite preview",
    "clean": "node cleanup.js",
    "benchmark:test": "node scripts/run-benchmark-tests.cjs",
    "ipc:check": "node scripts/check-ipc-surface.mjs",
    "test:ci": "npm run typecheck && npm run lint && npm run benchmark:test && node scripts/run-retained-tests.mjs && node scripts/check-ipc-surface.mjs && node scripts/release-check.mjs",
    "test:e2e-dictation": "node scripts/e2e-dictation.mjs",
    "prepare:win": "node scripts/prepare-windows-release.mjs",
    "test:release:win": "node --test test/release/windows-startup.mjs",
    "predist:win": "npm run prepare:win"
  },
  "keywords": [
    "dictation",
    "speech-to-text",
    "whisper",
    "whisper.cpp",
    "electron",
    "desktop-app"
  ],
  "author": {
    "name": "Abhinav Tiwary",
    "email": "abhinavtiwary15@users.noreply.github.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.2",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "concurrently": "^10.0.3",
    "cross-env": "^10.0.0",
    "electron": "^43.8.3",
    "electron-builder": "^26.4.0",
    "emojibase-data": "^17.0.0",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "espree": "^11.2.0",
    "globals": "17.5.0",
    "happy-dom": "^21.0.4",
    "postcss": "^8.5.10",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.1.10",
    "tsx": "^4.23.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.1",
    "vite": "^8.1.6",
    "@babel/parser": "7.29.7"
  },
  "dependencies": {
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@homebridge/dbus-native": "^0.7.9",
    "@napi-rs/keyring": "^1.3.0",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-direction": "1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@tanstack/react-virtual": "^3.13.2",
    "better-sqlite3": "12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.10",
    "i18next": "^26.3.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.10",
    "tailwind-merge": "^3.3.1",
    "zustand": "^5.0.11"
  },
  "overrides": {
    "adm-zip": "^0.6.1",
    "@xmldom/xmldom@^0.8.0": "0.8.15",
    "fast-xml-builder": "1.2.0",
    "ip-address": "10.2.0",
    "markdown-it": "14.3.3",
    "shell-quote": "1.12.0",
    "tmp": "0.2.7"
  },
  "productName": "DhwaniFlow"
}
