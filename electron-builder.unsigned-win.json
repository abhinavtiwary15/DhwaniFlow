{
  "appId": "io.github.abhinavtiwary15.dhwaniflow",
  "afterPack": "scripts/afterPack.js",
  "extraMetadata": {
    "windowsTrayIdentity": true
  },
  "productName": "DhwaniFlow",
  "directories": {
    "output": "dist"
  },
  "npmRebuild": true,
  "buildDependenciesFromSource": false,
  "files": [
    "main.js",
    "preload.js",
    "package.json",
    "node_modules/**/*",
    "src/dist/**/*",
    "src/helpers/**/*",
    "src/config/**/*",
    "src/constants/**/*",
    "src/locales/**/*",
    "src/hooks/**/*",
    "src/models/**/*",
    "src/types/**/*",
    "src/utils.js",
    "src/utils/**/*",
    "src/updater.js",
    "src/components.json",
    "!node_modules/.cache/**/*",
    "!src/node_modules/**/*",
    "!**/node_modules/electron/**",
    "!**/node_modules/electron-builder/**",
    "!**/node_modules/app-builder-bin/**",
    "!**/node_modules/app-builder-lib/**",
    "!**/node_modules/builder-util/**",
    "!**/node_modules/dmg-builder/**",
    "!**/node_modules/7zip-bin/**",
    "!**/node_modules/typescript/**",
    "!**/node_modules/prettier/**",
    "!**/node_modules/eslint/**",
    "!**/node_modules/eslint-*/**",
    "!**/node_modules/@eslint/**",
    "!**/node_modules/@typescript-eslint/**",
    "!**/node_modules/globals/**",
    "!**/node_modules/vite/**",
    "!**/node_modules/@vitejs/**",
    "!**/node_modules/esbuild/**",
    "!**/node_modules/@esbuild/**",
    "!**/node_modules/rollup/**",
    "!**/node_modules/@rollup/**",
    "!**/node_modules/postcss/**",
    "!**/node_modules/autoprefixer/**",
    "!**/node_modules/tailwindcss/**",
    "!**/node_modules/@tailwindcss/**",
    "!**/node_modules/lightningcss*/**",
    "!**/node_modules/react/**",
    "!**/node_modules/react-dom/**",
    "!**/node_modules/lucide-react/**",
    "!**/node_modules/@radix-ui/**",
    "!**/node_modules/class-variance-authority/**",
    "!**/node_modules/clsx/**",
    "!**/node_modules/tailwind-merge/**",
    "!**/node_modules/react-markdown/**",
    "!**/node_modules/@types/**",
    "!**/node_modules/concurrently/**",
    "!**/node_modules/cross-env/**",
    "!**/node_modules/@electron/notarize/**",
    "!**/node_modules/**/test/**",
    "!**/node_modules/**/tests/**",
    "!**/node_modules/**/*.ts",
    "!**/node_modules/**/*.map",
    "!**/node_modules/**/CHANGELOG*",
    "!**/node_modules/**/.github/**",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "asarUnpack": ["**/node_modules/better-sqlite3/**/*", "**/node_modules/@napi-rs/keyring/**/*"],
  "extraResources": [
    {
      "from": "src/assets",
      "to": "src/assets",
      "filter": ["**/*", "!fonts/yowza/**"]
    },
    {
      "from": "resources/bin/",
      "to": "bin/",
      "filter": ["windows-key-listener.exe", "windows-fast-paste.exe", "windows-helpers.json"]
    },
    {
      "from": "resources/windows-command-helper.ps1",
      "to": "windows-command-helper.ps1"
    },
    {
      "from": "LICENSE",
      "to": "LICENSE.dhwaniflow"
    },
    {
      "from": "THIRD_PARTY_NOTICES.md",
      "to": "third-party-notices.md"
    }
  ],
  "win": {
    "target": ["nsis"],
    "icon": "src/assets/icon.ico",
    "forceCodeSigning": false
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "include": "resources/nsis/installer.nsh"
  }
}
